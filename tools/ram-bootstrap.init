#!/bin/sh /etc/rc.common
START=99
STOP=01
USE_PROCD=1
start_service() {
 umask 077
 PATH=/usr/sbin:/usr/bin:/sbin:/bin
 export PATH
 unset LD_PRELOAD LD_LIBRARY_PATH APK_CONFIG
 procd_open_instance
 procd_set_param command /usr/bin/ucode /etc/foxhole/ram-update/bootstrap/ram-bootstrap.uc boot
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param term_timeout 70
 procd_close_instance
}
stop_service() {
 # The runtime owns Stop; this one-shot loader never unmounts an active generation.
 return 0
}
