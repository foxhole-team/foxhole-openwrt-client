{
  "name": "foxhole-openwrt-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node tools/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/check.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "build:source": "python3 tools/build-source.py --output dist/foxhole-openwrt-client-source.zip",
    "test:installer": "node --test tests/installer.test.mjs",
    "test:clean-install": "sh tests/clean-install.sh",
    "test:model": "node tests/run-model.mjs && node tests/run-probe.mjs"
  }
}
