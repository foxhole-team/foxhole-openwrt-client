#!/usr/bin/ucode
'use strict';

import * as fs from 'fs';
import * as backup from '/usr/share/foxhole/backup-service.uc';

if(fs.stat('/proc/self')?.uid!=0||length(ARGV)>1||length(ARGV)==1&&ARGV[0]!='--allow-stopped')
 die('Root backup recovery required\n');
try {backup.recover();}
catch(error) {
 // Stop can enforce the current disconnected policy while a live restore
 // worker owns the engine lock. This never permits a tunnel to start.
 if(ARGV[0]!='--allow-stopped'||!backup.stopped())die(error);
 exit(10);
}
print('Backup journal ready\n');
