#!/bin/sh
trap 'exit 0' TERM INT
journal_tick=0
while :; do
 /usr/libexec/foxhole-probe >/dev/null 2>&1
 /usr/libexec/foxhole-history >/dev/null 2>&1
 /usr/libexec/foxhole-update-job tick >/dev/null 2>&1
 /usr/libexec/foxhole-subscriptions >/dev/null 2>&1
 if [ "$journal_tick" -eq 0 ]; then
  /usr/libexec/foxhole-journal >/dev/null 2>&1
 fi
 journal_tick=$(( (journal_tick + 1) % 20 ))
 sleep 15 &
 wait "$!"
done
