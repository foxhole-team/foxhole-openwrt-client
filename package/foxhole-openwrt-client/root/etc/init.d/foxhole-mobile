#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=9

certificate='/etc/foxhole/mobile.crt'
private_key='/etc/foxhole/mobile.key'

start_service() {
	local address addresses ram_loader ram_root
	ram_loader=$(/usr/bin/ucode -e '
import * as fs from "fs";import * as digest from "digest";
let path="/tmp/foxhole-ram-active.json",s=fs.lstat(path);
if(s==null)exit(0);
if(s.type!="file"||s.uid!=0||s.nlink!=1||(s.mode&0o7777)!=0o600||s.size<1||s.size>4096)exit(1);
let marker=json(fs.readfile(path,4097));
if(marker.schema!=1||marker.storage!="RAM"||marker.phase!="active"||
 !match(marker.stage||"",/^\/tmp\/foxhole-ram-stage-[A-Za-z0-9_.-]{6,64}$/)&&
 !match(marker.stage||"",/^\/tmp\/foxhole\/ram-updates\/candidates\/candidate-[a-f0-9]{32}$/)||
 !match(marker.stageDbSha256||"",/^[a-f0-9]{64}$/))exit(1);
let root=marker.stage+"/root";
for(let p=root;;p=fs.dirname(p)){
 let d=fs.lstat(p);if(d?.type!="directory"||d.uid!=0||(d.mode&0o022)&&!(p=="/tmp"&&(d.mode&0o7777)==0o1777))exit(1);
 if(p=="/")break;
}
let db=root+"/lib/apk/db/installed",d=fs.lstat(db);
if(d?.type!="file"||d.uid!=0||d.nlink!=1||(d.mode&0o022)||d.size<1||d.size>4194304||
 digest.sha256(fs.readfile(db,4194305))!=marker.stageDbSha256)exit(1);
let arch=trim(fs.readfile("/etc/apk/arch",128)||""),name=arch=="aarch64_cortex-a53"?"ld-musl-aarch64.so.1":arch=="x86_64"?"ld-musl-x86_64.so.1":null;
if(name==null)exit(1);
let loader=root+"/lib/"+name,real=fs.realpath(loader),l=fs.stat(loader);
if(real==null||index(real,root+"/lib/")!=0||l?.type!="file"||l.uid!=0||(l.mode&0o022)||(l.mode&0o111)==0)exit(1);
print(loader);') || return 1
	/usr/libexec/foxhole-backup-recover >/dev/null 2>&1 || return 1
	addresses=$(/usr/libexec/foxhole-mobile-network prepare) || return 1
	[ -n "$addresses" ] || return 1
	/usr/libexec/foxhole-mobile-identity || return 1
	if [ -d /etc/foxhole/mobile-identity ]; then
		private_key='/etc/foxhole/mobile-identity/key.pem'
	fi
	if [ -n "$ram_loader" ]; then
		ram_root=${ram_loader%/lib/*}
		set -- "$ram_loader" --library-path "$ram_root/lib:$ram_root/usr/lib" /usr/sbin/uhttpd
	else
		set -- /usr/sbin/uhttpd
	fi
	set -- "$@" -f -h /www/foxhole-mobile
	for address in $addresses; do
		set -- "$@" -s "$address:8443"
	done
	procd_open_instance
	procd_set_param command "$@" \
		-x /cgi-bin \
		-C "$certificate" -K "$private_key" \
		-n 4 -N 16 -t 10 -T 20 -r FoxHole
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param file "$certificate" "$private_key"
	procd_close_instance
}

stop_service() {
	if /usr/libexec/foxhole-mobile-network clear >/dev/null 2>&1; then
		return 0
	fi
	# rc.common kills uhttpd after this hook. Keep a deny policy until then.
	/usr/sbin/nft -f - <<'FOXHOLE_MOBILE_DENY' || return 1
add table inet foxhole_mobile
delete table inet foxhole_mobile
table inet foxhole_mobile {
 chain input { type filter hook input priority filter - 10; policy accept;
  tcp dport 8443 counter drop
 }
}
FOXHOLE_MOBILE_DENY
	return 0
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger network firewall foxhole
}
