#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

controller='/usr/libexec/foxhole-runtime'
supervisor='/usr/libexec/foxhole-supervisor'

start_service() {
	local mode

	mode="$($controller mode)" || return 1
	if [ "$mode" = 'off' ]; then
		$controller cleanup >/dev/null 2>&1
		return $?
	fi

	procd_open_instance
	procd_set_param command "$supervisor"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 10
	procd_set_param file /etc/foxhole/state.json
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger foxhole network firewall dhcp
}
